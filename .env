SECRET_KEY=trash
STRIPE_PUBLISHABLE_KEY=trash
STRIPE_SECRET_KEY=trash
MOCHA_COLORS=yep

# Capybara batches the visibility checks for 3+ matched elements into one
# execute_script. When a React re-render invalidates the elements before that
# script runs, geckodriver passes null in place of the element array and the
# script raises a JavascriptError, which Capybara does not retry.
DISABLE_CAPYBARA_SELENIUM_OPTIMIZATIONS=true
