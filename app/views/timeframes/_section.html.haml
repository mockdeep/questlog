%div{ id: timeframe.name, class: timeframe_section_class(timeframe) }
  %hr
  %h2
    = timeframe_label(timeframe.name)
    - danger = 'danger' if timeframe_over_limit?(timeframe)
    %span{ class: danger }= timeframe_ratio(timeframe)
  %table.tasks-table
    = render Views::Tasks::TableHeaders.new(heading: 'Title', spaces:)
    %tbody
      - timeframe.current_tasks.each do |task|
        = render Views::Tasks::Row.new(task:, spaces:, status: nil,
          draggable: false)
      - timeframe.pending_tasks.each do |task|
        = render Views::Tasks::Row.new(task:, spaces:, status: 'pending',
          draggable: false)
