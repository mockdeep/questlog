= turbo_frame_tag 'task-details' do
  %section
    = render Views::Tasks::BreadCrumbs.new(task:)
    %h2= render Views::Tasks::TitleForm.new(task:)
    - details.each do |detail|
      %div= detail
    = render Views::Tasks::Table.new(tasks: sub_tasks,
      table_id: 'sub-tasks', heading: 'Sub-tasks', status: nil,
      draggable: false)

= render Views::Tasks::New.new(parent_task: task)
