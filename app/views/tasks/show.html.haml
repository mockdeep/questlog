= turbo_frame_tag 'task-details' do
  %section
    = render 'tasks/bread_crumbs', task:
    %h2= render 'tasks/title_form', task:
    - details.each do |detail|
      %div= detail
    = render 'tasks/table', tasks: sub_tasks, table_id: 'sub-tasks',
      heading: 'Sub-tasks', status: nil, draggable: false

= render 'tasks/new', parent_task: task
