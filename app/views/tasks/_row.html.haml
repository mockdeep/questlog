%tr{ **task_row_options(task, status:, draggable:) }
  %td.tasks-table__cell= task_action_button('DONE', task, done: true)
  %td= render Views::Tasks::TitleForm.new(task:)
  %td= task_link_to(edit_icon, task)
  %td #{task.estimate_minutes} min
  %td
    - if task.repeat_seconds
      %i.fas.fa-redo-alt{ title: 'task repeats' }
  %td
    = form_with(**task_field_form_options(task)) do
      - priorities = [['-', ''], ['1', 1], ['2', 2], ['3', 3]]
      = select_tag('task[priority]',
        options_for_select(priorities, task.priority), id: nil)
  %td
    - if spaces
      = form_with(**task_field_form_options(task)) do
        = select_tag('task[timeframe]', timeframe_options(task, spaces),
          id: nil, class: 'timeframe-select')
  %td= task_row_buttons(task)
