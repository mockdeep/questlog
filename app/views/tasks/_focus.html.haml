- content_for(:title, board.task ? board.task.title : '(no tasks!)')

= turbo_frame_tag 'focus' do
  - if board.task
    = render 'tasks/tag_buttons', tags: board.tags, task: board.task,
      slug: board.slug
    .row
      = render 'tasks/bread_crumbs', task: board.task
    = render 'tasks/task_title', task: board.task
    = render 'tasks/main_buttons', task: board.task
  - else
    %div
      %h2 No tasks! Try adding one below:

%hr

= render 'tasks/new'

%footer.task-footer
  %br
  = link_to('Add multiple tasks', new_bulk_task_path)
  |
  = dialog_link_to('Help', help_index_path)
  %br

  Try adding a tag using "#", for example: <strong>#home</strong> or
  <strong>#5-min</strong>. Click #{dialog_link_to('help', help_index_path)} for
  more.
