.row
  #task{ class: focus_task_classes(task) }
    %table
      %tbody
        %tr
          %td.col-xs-1
            - if task.timeframe
              .timeframe= timeframe_label(task.timeframe)
            = focus_delete_button(task)
          -#
            Every newline in this cell becomes a line box 45px tall, which
            stops the cell centring its content, so the whitespace is nuked.
          %td.col-xs-10.title
            .col-xs-10.col-xs-offset-1>
              = render Views::Tasks::TitleForm.new(task:)
            .col-xs-1>
              %span.emblems><= task_repeat_emblem(task)
          %td.col-xs-1= task_link_to(edit_icon, task)
